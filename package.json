{
  "name": "github-app",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "svc:restart": "sudo systemctl restart github-app && systemctl --no-pager status github-app | head -n 5",
    "svc:deploy": "git pull && pnpm install --frozen-lockfile && pnpm build && pnpm svc:restart",
    "svc:logs": "journalctl -u github-app -f",
    "svc:status": "systemctl is-active github-app && curl -s http://127.0.0.1:3200/healthz",
    "temp-server": "cloudflared tunnel --url http://localhost:3200 --protocol http2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:worker": "pnpm -C worker run deploy",
    "worker:dev": "pnpm -C worker run dev",
    "db:migrate": "pnpm -C worker run db:migrate",
    "db:migrate:local": "pnpm -C worker run db:migrate:local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
