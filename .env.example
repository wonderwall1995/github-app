PORT=3200
HOST=호스트아이피에용
LOG_LEVEL=info

# GitHub App 설정의 Webhook secret과 같은 값
GITHUB_WEBHOOK_SECRET=change-me

# GitHub App 설정 페이지 상단의 App ID (숫자)
GITHUB_APP_ID=123456
# GitHub App 설정에서 Generate a private key로 받은 .pem 파일의 경로 (프로젝트 루트 기준). credentials/ 폴더에 넣는다
GITHUB_APP_PRIVATE_KEY_PATH=credentials/