PORT=3200
HOST=호스트아이피에용
LOG_LEVEL=info

# GitHub App 설정의 Webhook secret과 같은 값
GITHUB_WEBHOOK_SECRET=change-me

# GitHub App 설정 페이지 상단의 App ID (숫자)
GITHUB_APP_ID=123456
# GitHub App 설정에서 Generate a private key로 받은 .pem 파일의 경로 (프로젝트 루트 기준). credentials/ 폴더에 넣는다
GITHUB_APP_PRIVATE_KEY_PATH=credentials/

# 선택: 코멘트 이벤트를 JSON으로 POST할 URL (예: 로컬 Hermes, 디버그용 수신기). 비워 두면 로그만 남긴다
HTTP_SINK_URL=
# 선택: 있으면 바디의 HMAC-SHA256을 X-Hub-Signature-256 헤더("sha256=<hex>" 형식)로 붙인다
HTTP_SINK_SECRET=
# 이벤트 수신 방식: webhook(GitHub이 이 서버로 직접 전송, 공개 URL 필요) 또는 worker(Cloudflare Worker에서 가져옴, 공개 URL 불필요). 기본 webhook
EVENT_SOURCE=worker
# worker 방식일 때만 필요
WORKER_URL=https://github-app-gate.내서브도메인.workers.dev
# Worker에 등록한 PULL_TOKEN과 같은 값 (openssl rand -hex 32 로 만든다)
WORKER_PULL_TOKEN=change-me
# Worker에 새 이벤트가 있는지 확인하는 간격(ms). 기본 20000
WORKER_POLL_INTERVAL_MS=20000
